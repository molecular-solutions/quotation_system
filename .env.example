# Copy to .env and fill in. Never commit .env.
# The first administrator, created on first start. Must be the email they sign in with at Cloudflare. Everyone else is
# added in the admin panel. There are no passwords: Cloudflare Access signs people in.
QUOTE_ADMIN_EMAIL=admin@your-company.com
QUOTE_ADMIN_NAME=Administrator
# Cloudflare Zero Trust -> Settings (team domain) and Access controls -> Applications -> your app -> Edit (AUD tag)
QUOTE_CF_TEAM_DOMAIN=your-team.cloudflareaccess.com
QUOTE_CF_AUD=paste-the-application-audience-tag
# QUOTE_PORT=8100          # host port on 127.0.0.1

# Outgoing e-mail for the "Email" button (optional). Gmail/Workspace: smtp.gmail.com, 587, starttls, and an App Password.
# QUOTE_SMTP_HOST=smtp.gmail.com
# QUOTE_SMTP_PORT=587
# QUOTE_SMTP_SECURITY=starttls      # starttls | ssl | none
# QUOTE_SMTP_USER=sales@your-company.com
# QUOTE_SMTP_PASSWORD=app-password
# QUOTE_SMTP_FROM=sales@your-company.com
# QUOTE_SMTP_FROM_NAME=Molecular Solutions
